# Required
ANTHROPIC_API_KEY=

# Optional — password for the Streamlit login gate (defaults to "demo")
APP_PASSWORD=

# --- Web research provider ---
# "mock" = local JSON file (no API calls), "httpx" = fetch known URL only, "claude" = live web search via Claude API
# WEB_RESEARCH_PROVIDER overrides use_mock_data for web research only.
WEB_RESEARCH_PROVIDER=claude

# --- Monday.com integration ---
# Set CRM_REPOSITORY=monday to use live data; omit or set to "mock" for local demo mode.
CRM_REPOSITORY=mock

# Required when CRM_REPOSITORY=monday
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

# Optional — defaults to 2026-01
MONDAY_API_VERSION=2026-01

# Optional — override with the stable column IDs from your board.
# Run: python scripts/test_monday_connection.py  to discover your column IDs.
MONDAY_COL_INDUSTRY=industry
MONDAY_COL_COMPANY_SIZE=company_size
MONDAY_COL_PRODUCTS=products_discussed
MONDAY_COL_QUESTIONS=open_questions
MONDAY_COL_FOLLOWUPS=open_followups

# --- Google Sheets integration (research blog catalog) ---
# Set BLOG_REPOSITORY=google_sheets to load blogs from a Google Sheet.
# Omit or set to "mock" / "csv" for local demo mode.
BLOG_REPOSITORY=mock

# Required when BLOG_REPOSITORY=google_sheets
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json

# Optional — defaults to the range below.  Keep the outer double quotes and inner single quotes.
GOOGLE_SHEET_RANGE="'Blog Categories'!A:G"

# Optional — seconds to cache the sheet data in memory (default 300)
GOOGLE_CACHE_TTL_SECONDS=300
